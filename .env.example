# Used by docker-compose at the repo root. Copy to .env (never commit .env).
NODE_ENV=development

POSTGRES_USER=socialguard
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=socialguard
DATABASE_URL=postgresql://socialguard:change-me-locally@postgres:5432/socialguard

REDIS_URL=redis://redis:6379

API_PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=generate-a-long-random-string
JWT_REFRESH_SECRET=generate-a-different-long-random-string

ML_SERVICE_URL=http://ml-service:8000
ACTIVE_MODEL_VERSION=v1

# Prototype thresholds; validate on real authorized data before operational use.
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_MEDIUM=0.70

VITE_API_URL=http://localhost:3000
VITE_ML_URL=http://localhost:8000
# Comma-separated browser origins allowed to call the ML service; add the exact frontend origin if non-default.
ML_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://10.244.202.218:5173
